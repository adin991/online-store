{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Stripe keys are NOT stored in source control.
  // Set them locally with .NET User Secrets (run inside WebShop.API):
  //   dotnet user-secrets set "Stripe:SecretKey" "sk_test_..."
  //   dotnet user-secrets set "Stripe:PublishableKey" "pk_test_..."
  // or with environment variables: Stripe__SecretKey / Stripe__PublishableKey
  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "SET_IN_USER_SECRETS"
  }
}
